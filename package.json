{
  "name": "hundo-leago",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=desktop-chromium --project=mobile-chromium",
    "test:e2e:release": "playwright test --project=desktop-chromium --project=mobile-chromium --project=desktop-firefox --project=desktop-webkit --project=mobile-webkit",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "preview": "vite preview",
    "server": "node server.cjs",
    "verify:m3-browser-authority": "node scripts/verify-m3-browser-authority.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "0.487.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "29.1.1",
    "playwright-core": "1.61.1",
    "vite": "^7.3.6",
    "vitest": "4.1.10"
  }
}
